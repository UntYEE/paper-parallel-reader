DEEPSEEK_API_KEY=填你的 DeepSeek API Key
PAPER_READER_IMAGE=ghcr.io/untyee/paper-parallel-reader:latest
PAPER_READER_OCR_IMAGE=ghcr.io/untyee/paper-parallel-reader:ocr
APP_PORT=8000
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PAPER_DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_DOWNLOAD_MB=100
PAPER_DOWNLOAD_TIMEOUT=75
ENABLE_OCR=false
MODEL_CACHE_DIR=./data/model-cache
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=180
DEEPSEEK_INPUT_PRICE_USD_PER_MILLION=0.44
DEEPSEEK_CACHED_INPUT_PRICE_USD_PER_MILLION=0.014
DEEPSEEK_OUTPUT_PRICE_USD_PER_MILLION=1.32
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_SEARCH_MAX_USES=3
PAPER_SEARCH_TIMEOUT=45
# 检索结果缓存时长（小时，设为 0 关闭）；命中缓存不再联网、不产生费用
PAPER_SEARCH_CACHE_TTL_HOURS=168
# 学术 API（arXiv/Crossref/OpenAlex/Semantic Scholar）单次请求超时与响应上限
PAPER_SEARCH_API_TIMEOUT=20
PAPER_SEARCH_RESPONSE_MB=8
# 每次检索最多实际校验多少个开放 PDF 链接（0 表示不校验）
PAPER_SEARCH_VERIFY_LIMIT=6
# 填上自己的邮箱后会启用 Unpaywall 开放 PDF 查询，并让 Crossref/OpenAlex 使用礼貌池（留空则跳过）
PAPER_SEARCH_CONTACT_EMAIL=
PAPER_PDF_VERIFY_TIMEOUT=10
QA_MODEL=deepseek-v4-flash
QA_EVIDENCE_LIMIT=6
DOCLING_TIMEOUT=180
DOCLING_OCR_LANGUAGE=en
